# Cabbie v2.0
# (C) 2010-2026 The Authors (see /rockbox/wps/AUTHORS)
# Derived from "Cabbie v2.0" (C) 2010-2012 The Authors
#
# The FM screen, of the main display and of the remote: the WPS backdrop,
# header, bar and status icons, the station where the track info is, the
# signal strength where shuffle, repeat and play mode are.
#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(backdrop-128x96x2.bmp)
#
# Header font
%Fl(2,05-Cabbie-Bold.fnt)
#
# Preload Images
%xl(lock,lock-160x128x2.bmp,0,1,2)
%xl(battery,battery-160x128x2.bmp,0,2,10)
%xl(volume,volume-160x128x2.bmp,0,1,10)
#
# Preset present conditional
# RDS present conditional
%?Ti<%Vd(preset)>
%?tx<%?Ti<%Vd(preset_rds)|%Vd(nopreset_rds)>|>
#
# Header
%V(2,2,124,5,2)%Vf(3)
%acFM RADIO
#
# Frequency Bar
%V(0,58,128,12,1)%Vf(0)%Vb(3)
%pb(1,3,125,7,pb-128x96x2.bmp)
#
# Hold
%V(3,83,23,13,1)%Vf(0)%Vb(3)
%xd(lock,%mh)
#
# Battery
%V(26,83,23,13,1)%Vf(0)%Vb(3)
%?bp<%?bc<%xd(battery,1)|%xd(battery,2)>|%?bl<|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)>>
#
# Volume
%V(49,83,23,13,1)%Vf(0)%Vb(3)
%xd(volume,%pv)
#
# Signal strength, where the tuner reports it
%V(72,83,53,13,1)%Vf(0)%Vb(3)
%ar%?tr<%tr dBuV>
#
# Below frequency bar Scan/Preset frequency MHz Force Mono/Mono/Stereo
%V(3,70,122,12,1)%Vf(0)%Vb(3)
%al%tf MHz %ar%?St(force fm mono)<%Sx(Force Mono)|%?ts<%Sx(Stereo)|%Sx(Mono)>>
#
# Preset present
%Vl(preset,0,10,128,12,1)%Vf(0)%Vb(3)
%Vp(0,%s%ac%?Ti<%Sx(Station:) |>%?Tn<%Tn|%Tf>)
%Vl(preset,0,22,128,12,1)%Vf(0)%Vb(3)
%Vp(1,%s%ac%?Ti<%Sx(Next:) |>%?Tn<%Tn|%Tf>)
#
%Vl(preset_rds,0,34,128,24,1)%Vf(0)%Vb(3)
%s%ac%ty
%s%ac%tz
#
# Preset absent
%Vl(nopreset_rds,0,22,128,24,1)%Vf(0)%Vb(3)
%s%ac%ty
%s%ac%tz
