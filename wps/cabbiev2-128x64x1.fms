# Cabbie v2.0
# (C) 2010-2026 The Authors (see /rockbox/wps/AUTHORS)
# Derived from "Cabbie v2.0" (C) 2010-2012 The Authors
#
# The FM screen, of the main display and of the remote, laid out as the
# WPS: the frequency in the bar at the top, the station where the track
# info is, the signal strength where shuffle, repeat and play mode are.
#
# Disable Status Bar
%wd
#
# Preload Images
%xl(lock,lock-128x64x1.bmp,0,0,2)
%xl(battery,battery-128x64x1.bmp,0,0,9)
%xl(volume,volume-128x64x1.bmp,0,0,9)
%xl(b,bar-128x64x1.bmp,2,0)
#
# Preset present conditional
# RDS present conditional
%?Ti<%Vd(preset)>
%?tx<%?Ti<%Vd(preset_rds)|%Vd(nopreset_rds)>|>
#
# Frequency Bar
%V(0,0,128,6,1)
%x(a,pbbackground-128x64x1.bmp,1,0)
%pb(2,1,123,4,pb-128x64x1.bmp)
#
# Scan/Preset frequency MHz Force Mono/Mono/Stereo
%V(0,8,128,8,1)
%al%tf MHz %ar%?St(force fm mono)<%Sx(Force Mono)|%?ts<%Sx(Stereo)|%Sx(Mono)>>
#
# Preset present
%Vl(preset,0,16,128,8,1)
%Vp(0,%s%ac%?Ti<%Sx(Station:) |>%?Tn<%Tn|%Tf>)
%Vl(preset,0,42,128,8,1)
%Vp(1,%s%ac%?Ti<%Sx(Next:) |>%?Tn<%Tn|%Tf>)
#
%Vl(preset_rds,0,24,128,16,1)
%s%ac%ty
%s%ac%tz
#
# Preset absent
%Vl(nopreset_rds,0,24,128,16,1)
%s%ac%ty
%s%ac%tz
#
# Line
%V(2,52,124,1,1)
%xd(b)
#
# Hold
%V(3,56,20,8,1)
%xd(lock,%mh)
#
# Battery
%V(25,56,23,8,1)
%?bp<%?bc<%xd(battery,1)|%xd(battery,2)>|%?bl<|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)>>
#
# Volume
%V(48,56,21,8,1)
%xd(volume,%pv)
#
# Signal strength, where the tuner reports it
%V(69,56,59,8,1)
%ar%?tr<%tr dBuV>
