# Cabbie v2.0
# (C) 2010-2026 The Authors (see /rockbox/wps/AUTHORS)
# Derived from "Cabbie v2.0" (C) 2007-2012 The Authors
#
# Recording screen: the WPS backdrop and header, the settings list where
# the track info is, the peak meters in the progress bar.
#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(backdrop-132x80x16.bmp)
#
# Header font
%Fl(2,10-Adobe-Helvetica-Bold.fnt)
#
# Preload Images
%xl(lock,lock-132x80x16.bmp,0,0,2)
%xl(battery,battery-132x80x16.bmp,0,0,10)
%xl(volume,volume-132x80x16.bmp,0,0,10)
%xl(recmode,recmode-132x80x16.bmp,0,0,3)
#
# Header
%V(2,1,128,10,2)%Vf(0F0B00)
%acRECORDING
#
# Settings list
%Vi(-,0,11,132,33,1)
#
# Peak meters, left over right, in the progress bar: each the half of the
# WPS progress bar image; they fall back slowly and mark the held peak
%V(2,58,127,6,-)
%pL(0,0,127,2,image,pbl-132x80x16.bmp,hold,2)
%pR(0,4,127,2,image,pbr-132x80x16.bmp,hold,2)
#
# Recording time, file size, and the source or state
%V(2,45,128,11,1)
%al%Rh:%Rn:%Rs%ar%?Rw<! %Rw|%?RP<%Sx(Pre-Recording) %RPs|%?Rt<%?Ri<%Ri|%Ri|%Ri|%?ty<%ty|%?Tn<%Tn|%tf MHz>>>|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)>>>
#
# Hold
%V(36,69,12,9,-)
%xd(lock,%mh)
#
# Battery
%V(51,69,16,9,-)
%?bp<%?bc<%xd(battery,1)|%xd(battery,2)>|%?bl<|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)>>
#
# Volume
%V(69,69,13,9,-)
%xd(volume,%pv)
#
# Recording, paused or ready, where the WPS shows play or pause
%V(118,67,10,11,-)
%?mp<%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,2)|%xd(recmode,3)|%xd(recmode,1)|%xd(recmode,1)>
