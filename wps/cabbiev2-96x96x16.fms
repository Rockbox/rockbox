# Cabbie v2.0
# (C) 2010-2026 The Authors (see /rockbox/wps/AUTHORS)
# Derived from "Cabbie v2.0" (C) 2010-2012 The Authors
#
# The FM screen: the WPS backdrop, header, bar and status icons, the
# station where the track info is, the signal strength where shuffle,
# repeat and play mode are.
#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(backdrop-96x96x16.bmp)
#
# Header font
%Fl(2,05-Cabbie-Bold.fnt)
#
# Preload Images
%xl(lock,lock-96x96x16.bmp,0,0,2)
%xl(battery,battery-96x96x16.bmp,0,0,10)
%xl(volume,volume-96x96x16.bmp,0,0,10)
#
# Station Art/Info Viewport Conditional
# Preset present conditional
# RDS present conditional
%?C<%Vd(art)>
%?Ti<%?C<%Vd(art_preset)|%Vd(noart_preset)>>
%?tx<%?Ti<%?C<%Vd(art_preset_rds)|%Vd(noart_preset_rds)>|%?C<%Vd(art_nopreset_rds)|%Vd(noart_nopreset_rds)>>|>
# Next station conditional
%?Ti<%Vd(next)>
#
# Header
%V(2,2,92,5,2)%Vf(0F0B00)
%acFM RADIO
#
# Frequency Bar
%V(2,65,92,5,-)
%pb(0,0,92,5,pb-96x96x16.bmp)
#
# Hold
%V(2,85,13,10,-)
%xd(lock,%mh)
#
# Battery
%V(17,85,19,10,-)
%?bp<%?bc<%xd(battery,1)|%xd(battery,2)>|%?bl<|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)>>
#
# Volume
%V(39,85,14,10,-)
%xd(volume,%pv)
#
# Signal strength, where the tuner reports it
%V(55,84,40,8,1)
%ar%?tr<%tr dBuV>
#
# Below frequency bar Scan/Preset frequency MHz Force Mono/Mono/Stereo
%V(2,73,92,8,1)
%al%tf MHz %ar%?ts<%Sx(Stereo)|%Sx(Mono)>
#
# Next station, where the WPS shows the next track
%Vl(next,2,56,92,8,1)
%Vp(1,%s%ac%?Ti<%Sx(Next:) |>%?Tn<%Tn|%Tf>)
#
# Station Art
%ax%Vl(art,4,10,45,45,-)
%Cl(0,0,45,45,c,c)
%Cd
#
# Station art
# Preset present
%ax%Vl(art_preset,51,12,-,8,1)
%Vp(0,%s%al%?Ti<%Sx(Station:) |>%?Tn<%Tn|%Tf>)
#
%ax%Vl(art_preset_rds,51,20,-,16,1)
%s%al%ty
%s%al%tz
#
# Preset absent
%ax%Vl(art_nopreset_rds,51,20,-,16,1)
%s%al%ty
%s%al%tz
#
# No station art
# Preset present
%Vl(noart_preset,0,12,-,8,1)
%Vp(0,%s%ac%?Ti<%Sx(Station:) |>%?Tn<%Tn|%Tf>)
#
%Vl(noart_preset_rds,0,20,-,16,1)
%s%ac%ty
%s%ac%tz
#
# Preset absent
%Vl(noart_nopreset_rds,0,20,-,16,1)
%s%ac%ty
%s%ac%tz
