# Cabbie v2.0
# (C) 2010-2026 The Authors (see /rockbox/wps/AUTHORS)
# Derived from "Cabbie v2.0" (C) 2010-2012 The Authors
#
# The FM screen: the WPS backdrop, header, bar and status icons, the
# station where the track info is, the signal strength where shuffle,
# repeat and play mode are.
#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(backdrop-240x400x16.bmp)
#
# Header font
%Fl(2,12-Adobe-Helvetica-Bold.fnt)
#
# Preload Images
%xl(lock,lock-240x320x16.bmp,0,0,2)
%xl(battery,battery-240x320x16.bmp,0,0,10)
%xl(volume,volume-240x320x16.bmp,0,0,10)
#
# Station Art/Info Viewport Conditional
# Preset present conditional
# RDS present conditional
%?C<%Vd(art)>
%?Ti<%?C<%Vd(art_preset)|%Vd(noart_preset)>>
%?tx<%?Ti<%?C<%Vd(art_preset_rds)|%Vd(noart_preset_rds)>|%?C<%Vd(art_nopreset_rds)|%Vd(noart_nopreset_rds)>>|>
#
# Header
%V(22,25,198,12,2)%Vf(0F0B00)
%acFM RADIO
#
# Frequency Bar
%V(22,284,199,13,-)
%pb(0,0,199,13,pb-240x320x16.bmp)
#
# Hold
%V(11,372,31,28,-)
%xd(lock,%mh)
#
# Battery
%V(46,372,45,28,-)
%?bp<%?bc<%xd(battery,1)|%xd(battery,2)>|%?bl<|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)>>
#
# Volume
%V(98,372,34,28,-)
%xd(volume,%pv)
#
# Signal strength, where the tuner reports it
%V(139,378,98,16,1)
%ar%?tr<%tr dBuV>
#
# Below frequency bar Scan/Preset frequency MHz Force Mono/Mono/Stereo
%V(21,300,199,20,1)
%al%tf MHz %ar%?ts<%Sx(Stereo)|%Sx(Mono)>
#
# Station Art
%ax%Vl(art,55,50,130,130,-)
%Cl(0,0,130,130,c,c)
%Cd
#
# Station art
# Preset present
%ax%Vl(art_preset,11,186,218,16,1)
%Vp(0,%s%al%?Ti<%Sx(Station:) |>%?Tn<%Tn|%Tf>)
%ax%Vl(art_preset,11,202,218,16,1)
%Vp(1,%s%al%?Ti<Next station: |>%?Tn<%Tn|%Tf>)
#
%ax%Vl(art_preset_rds,11,218,218,32,1)
%s%al%ty
%s%al%tz
#
# Preset absent
%ax%Vl(art_nopreset_rds,11,202,218,32,1)
%s%al%ty
%s%al%tz
#
# No station art
# Preset present
%Vl(noart_preset,11,60,218,16,1)
%Vp(0,%s%ac%?Ti<%Sx(Station:) |>%?Tn<%Tn|%Tf>)
%Vl(noart_preset,11,76,218,16,1)
%Vp(1,%s%ac%?Ti<Next station: |>%?Tn<%Tn|%Tf>)
#
%Vl(noart_preset_rds,11,92,218,32,1)
%s%ac%ty
%s%ac%tz
#
# Preset absent
%Vl(noart_nopreset_rds,11,76,218,32,1)
%s%ac%ty
%s%ac%tz
