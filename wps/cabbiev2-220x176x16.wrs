# Cabbie v2.0
# (C) 2010-2026 The Authors (see /rockbox/wps/AUTHORS)
# Derived from "Cabbie v2.0" (C) 2007-2012 The Authors
#
# Recording screen: the WPS backdrop and header, the settings list where
# the track info is, the peak meters in the progress bar.
#
# Disable Status Bar
%wd
#
# Load Backdrop
%X(backdrop-220x176x16.bmp)
#
# Header font
%Fl(2,10-Adobe-Helvetica-Bold.fnt)
#
# Preload Images
%xl(lock,lock-220x176x16.bmp,0,0,2)
%xl(battery,battery-220x176x16.bmp,0,0,10)
%xl(volume,volume-220x176x16.bmp,0,0,10)
%xl(recmode,recmode-220x176x16.bmp,0,0,3)
#
# Header
%V(11,9,199,10,2)%Vf(0F0B00)
%acRECORDING
#
# Source - for FM radio the station and frequency - or a warning,
# pre-recording or trigger state, and gain
%V(11,20,199,12,1)
%al%?Rw<! %Rw|%?RP<%Sx(Pre-Recording) %RPs|%?Rt<%?Ri<%Ri|%Ri|%Ri|%?ty<%ty|%?Tn<%Tn|%Ri>> %tf MHz>|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)|%Sx(Trigger)>>>%ar%?Rg<%Rg dB|>
#
# Settings list
%Vi(-,0,33,220,84,1)
#
# Peak meters, left over right, in the progress bar: each the half of the
# WPS progress bar image; they fall back slowly and mark the held peak
%V(11,121,199,8,-)
%pL(0,0,199,3,image,pbl-220x176x16.bmp,hold,2)
%pR(0,5,199,3,image,pbr-220x176x16.bmp,hold,2)
#
# Recording time, file size, clips
%V(11,132,199,12,1)
%al%Rh:%Rn:%Rs%ac%RS%ar%Sx(CLIP:) %Rc
#
# Hold
%V(88,152,17,13,-)
%xd(lock,%mh)
#
# Battery
%V(110,153,20,11,-)
%?bp<%?bc<%xd(battery,1)|%xd(battery,2)>|%?bl<|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)>>
#
# Volume
%V(134,153,16,11,-)
%xd(volume,%pv)
#
# Recording, paused or ready, where the WPS shows play or pause
%V(200,152,12,13,-)
%?mp<%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,1)|%xd(recmode,2)|%xd(recmode,3)|%xd(recmode,1)|%xd(recmode,1)>
