#
# common
#
PREFIX?=mipsel-elf-
CC=$(PREFIX)gcc
LD=$(PREFIX)gcc
AS=$(PREFIX)gcc
OC=$(PREFIX)objcopy
DEFINES=
INCLUDES=-I$(CURDIR) -I$(CURDIR)/build
GCCOPTS=-march=mips32r2 -G0 -mno-abicalls -fno-pic
BUILD_DIR=$(CURDIR)/build/
ROOT_DIR=$(CURDIR)/..
TOOLS_DIR=$(ROOT_DIR)/../../../tools

# The package for "jztool <device> load" is a tar of an SPL (spl.<ext>), which
# sets up the DDR, and hwstub in place of the bootloader. The SPL is built from
# spl/ for DDR_SIZE MiB of DDR, picked from EXT (the device's file extension in
# jztool). To use the SPL of a Rockbox bootloader build instead:
#   make SPL=/path/to/bootloader-build/spl.rockern
ifdef SPL
EXT=$(subst .,,$(suffix $(SPL)))
else
EXT?=rockern
ifeq ($(EXT),$(filter $(EXT),m3k q1))
DDR_SIZE?=64
else ifeq ($(EXT),$(filter $(EXT),erosq rockern))
DDR_SIZE?=32
endif
ifndef DDR_SIZE
$(error unknown DDR size for $(EXT), set DDR_SIZE to 32 or 64)
endif
endif
EXEC=$(BUILD_DIR)/hwstub.$(EXT)

# Backlight pin (port C), switched on at start, as SPL_ERROR_PIN in Rockbox
ifeq ($(EXT),m3k)
BACKLIGHT_PC=24
else ifeq ($(EXT),$(filter $(EXT),q1 erosq rockern))
BACKLIGHT_PC=25
endif

include ../hwstub.make

# device settings that depend on EXT, rewritten only when they change
$(BUILD_DIR)/device.h: FORCE
	$(SILENT)mkdir -p $(dir $@)
	$(SILENT)(echo "/* generated by the Makefile for EXT=$(EXT) */"; \
	  $(if $(BACKLIGHT_PC),echo "#define BACKLIGHT_PC $(BACKLIGHT_PC)";) true) \
	  > $@.tmp
	$(SILENT)cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

$(BUILD_DIR)/x1000/target.o: $(BUILD_DIR)/device.h

$(BUILD_DIR)/bootloader.ucl: $(EXEC_BIN) $(TOOLS_DIR)/uclpack
	$(call PRINTS,UCLPACK $(@F))
	$(SILENT)$(TOOLS_DIR)/uclpack --nrv2e -9 $< $@ >/dev/null

$(BUILD_DIR)/bootloader-info.txt:
	$(SILENT)mkdir -p $(dir $@)
	$(SILENT)echo hwstub > $@

ifdef SPL
$(BUILD_DIR)/spl.$(EXT): $(SPL)
	$(SILENT)mkdir -p $(dir $@)
	$(SILENT)cp $< $@
else
SPL_OBJ=$(BUILD_DIR)/spl/spl-start.o $(BUILD_DIR)/spl/spl.o
SPL_CFLAGS=$(CFLAGS) -Os -DSPL_DDR_MEMORYSIZE=$(DDR_SIZE)

# DDR_SIZE may change without any file changing
$(BUILD_DIR)/spl/ddr_size: FORCE
	$(SILENT)mkdir -p $(dir $@)
	$(SILENT)echo $(DDR_SIZE) | cmp -s - $@ || echo $(DDR_SIZE) > $@

$(BUILD_DIR)/spl/spl.o: spl/spl.c x1000.h $(BUILD_DIR)/spl/ddr_size
	$(call PRINTS,CC $(<F))
	$(SILENT)$(CC) $(SPL_CFLAGS) -c -o $@ $<

$(BUILD_DIR)/spl/spl-start.o: spl/spl-start.S
	$(call PRINTS,AS $(<F))
	$(SILENT)mkdir -p $(dir $@)
	$(SILENT)$(AS) $(SPL_CFLAGS) -D__ASSEMBLER__ -c -o $@ $<

$(BUILD_DIR)/spl/spl.elf: $(SPL_OBJ) spl/spl.lds
	$(call PRINTS,LD $(@F))
	$(SILENT)$(LD) $(GCCOPTS) -nostdlib -Tspl/spl.lds \
		-Wl,-Map,$(BUILD_DIR)/spl/spl.map -o $@ $(SPL_OBJ) -lgcc

$(BUILD_DIR)/spl/spl.bin: $(BUILD_DIR)/spl/spl.elf
	$(call PRINTS,OC $(@F))
	$(SILENT)$(OC) -O binary $< $@

$(TOOLS_DIR)/mkspl-x1000 $(TOOLS_DIR)/uclpack:
	$(SILENT)$(MAKE) -C $(TOOLS_DIR) $(@F)

$(BUILD_DIR)/spl.$(EXT): $(BUILD_DIR)/spl/spl.bin $(TOOLS_DIR)/mkspl-x1000
	$(call PRINTS,MKSPL $(@F))
	$(SILENT)$(TOOLS_DIR)/mkspl-x1000 -type=nand -ppb=2 -bpp=2 $< $@
endif

.PHONY: FORCE

$(BUILD_DIR)/hwstub.$(EXT): $(BUILD_DIR)/spl.$(EXT) $(BUILD_DIR)/bootloader.ucl $(BUILD_DIR)/bootloader-info.txt
	$(call PRINTS,TAR $(@F))
	$(SILENT)tar -C $(BUILD_DIR) --numeric-owner --owner=0 --group=0 \
		-cf $@ $(notdir $^)
